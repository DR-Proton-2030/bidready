# Copy to .env.local and adjust. .env.local is gitignored.
#
# Without NEXT_PUBLIC_BASE_URL the app cannot reach the API, so login fails —
# and because collaboration identity comes from the signed-in user, presence and
# realtime sync go silently inert with no error in the UI.

# bidready-server (Express API).
NEXT_PUBLIC_BASE_URL=http://localhost:8989/api/v1

# Realtime collaboration socket, served by bidready-pdf-converter
# (`npm run start:collab`, COLLAB_WS_PORT, default PORT + 2).
#
# Optional locally — it defaults to ws://<current-hostname>:8991. It is REQUIRED
# in production: an https:// page cannot open a ws:// socket, so this must be a
# wss:// URL there or the browser blocks the connection as mixed content.
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:8991

# Google sign-in (optional).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
